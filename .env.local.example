# Copy this file to `.env.local` when you want the app to use local Dockerized Supabase.
# Then replace the placeholder values with the output from `npm run supabase:status:env`.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SECRET_KEY=replace-with-local-secret-key

# Protects the internal durable-sync drain endpoint. Use a long random value.
INTEGRATION_SYNC_SECRET=replace-with-random-secret

# Used by `npm run sync:drain`; point this at the running app.
SYNC_DRAIN_URL=http://localhost:3000
